    "%@ {sender}, {type} and {subject} stay empty; {docdate} and {person} still work.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ {sender}, {type} und {subject} bleiben leer; {docdate} und {person} funktionieren weiterhin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ {sender}, {type} et {subject} restent vides ; {docdate} et {person} fonctionnent toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ {sender}, {type} y {subject} permanecen vacíos; {docdate} y {person} todavía funcionan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ {sender}, {type} 및 {subject}는 비어 있습니다. {docdate} 및 {person}는 여전히 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ {sender}, {type} en {subject} blijven leeg; {docdate} en {person} werken nog steeds."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ {sender}, {type} e {subject} rimangono vuoti; {docdate} e {person} funzionano ancora."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ {sender}, {type} e {subject} permanecem vazios; {docdate} e {person} ainda funcionam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ {sender}、{type}、および {subject} は空のままです。 {docdate} と {person} は引き続き機能します。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ {sender}, {type} ve {subject} boş kalır; {docdate} ve {person} hala çalışıyor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ {sender} و{type} و{subject} تظل فارغة؛ لا يزال {docdate} و{person} يعملان."
          }
        }
      }
    },
