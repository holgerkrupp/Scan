{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "{name} is proposed on this Mac by Apple Intelligence from the text of the first pages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} wird auf diesem Mac von Apple Intelligence aus dem Text der ersten Seiten vorgeschlagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} est proposé sur ce Mac par Apple Intelligence dès le texte des premières pages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} es propuesto en este Mac por Apple Intelligence a partir del texto de las primeras páginas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{name}는 첫 페이지의 텍스트에서 Apple Intelligence에 의해 이 Mac에 제안되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} wordt op deze Mac voorgesteld door Apple Intelligence uit de tekst op de eerste pagina's."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} viene proposto su questo Mac da Apple Intelligence fin dal testo delle prime pagine."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} é proposto neste Mac pela Apple Intelligence a partir do texto das primeiras páginas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{name} は、最初のページの本文から Apple Intelligence によってこの Mac 上で提案されています。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{name}, bu Mac'te Apple Intelligence tarafından ilk sayfalardaki metinlerden önerilmiştir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اقتراح {name} على جهاز Mac هذا بواسطة Apple Intelligence من نص الصفحات الأولى."
          }
        }
      }
    },
    "{sender}, {type} and {subject} are read on this Mac by Apple Intelligence, using only words written in the document. {docdate} is the date the document was written, or the scan date. {person} comes from the people list in Settings ▸ Language.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{sender}, {type} und {subject} werden auf diesem Mac von Apple Intelligence gelesen, wobei nur im Dokument geschriebene Wörter verwendet werden. {docdate} ist das Datum, an dem das Dokument geschrieben wurde, oder das Scandatum. {person} stammt aus der Personenliste unter Einstellungen ▸ Sprache."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{sender}, {type} et {subject} sont lus sur ce Mac par Apple Intelligence, en utilisant uniquement les mots écrits dans le document. {docdate} est la date à laquelle le document a été rédigé ou la date de numérisation. {person} provient de la liste des personnes dans Paramètres ▸ Langue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence lee {sender}, {type} y {subject} en esta Mac, utilizando solo palabras escritas en el documento. {docdate} es la fecha en que se escribió el documento o la fecha de escaneo. {person} proviene de la lista de personas en Configuración ▸ Idioma."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{sender}, {type} 및 {subject}는 이 Mac에서 문서에 작성된 단어만 사용하여 Apple Intelligence에서 읽습니다. {docdate}는 문서가 작성된 날짜 또는 스캔 날짜입니다. {person}는 설정 ▸ 언어의 사람 목록에서 나옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "{sender}, {type} en {subject} worden op deze Mac gelezen door Apple Intelligence, waarbij alleen de woorden worden gebruikt die in het document zijn geschreven. {docdate} is de datum waarop het document is geschreven of de scandatum. {person} komt uit de personenlijst in Instellingen ▸ Taal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{sender}, {type} e {subject} vengono letti su questo Mac da Apple Intelligence, utilizzando solo le parole scritte nel documento. {docdate} è la data in cui è stato scritto il documento o la data di scansione. {person} proviene dall'elenco delle persone in Impostazioni ▸ Lingua."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{sender}, {type} e {subject} são lidos neste Mac pela Apple Intelligence, usando apenas palavras escritas no documento. {docdate} é a data em que o documento foi escrito ou a data da digitalização. {person} vem da lista de pessoas em Configurações ▸ Idioma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{sender}、{type}、{subject} は、Apple Intelligence によってこの Mac 上で読み取られ、ドキュメントに書かれた単語のみが使用されます。 {docdate} は、ドキュメントが書き込まれた日付、またはスキャンした日付です。 {person} は、[設定] ▸ [言語] のユーザー リストから取得されます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{sender}, {type} ve {subject} bu Mac'te Apple Intelligence tarafından yalnızca belgede yazılan sözcükler kullanılarak okunur. {docdate}, belgenin yazıldığı tarih veya tarama tarihidir. {person}, Ayarlar ▸ Dil bölümündeki kişiler listesinden gelir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم قراءة {sender} و{type} و{subject} على جهاز Mac هذا بواسطة Apple Intelligence، باستخدام الكلمات المكتوبة في المستند فقط. {docdate} هو تاريخ كتابة المستند أو تاريخ المسح الضوئي. يأتي {person} من قائمة الأشخاص في الإعدادات ▸ اللغة."
          }
        }
      }
    },
