    "Finds connected scanners and updates Scan's device list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet angeschlossene Scanner und aktualisiert die Geräteliste von Scan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche les scanners connectés et met à jour la liste des appareils de Scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra escáneres conectados y actualiza la lista de dispositivos de Scan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 스캐너를 찾고 Scan의 장치 목록을 업데이트합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vindt aangesloten scanners en werkt de apparatenlijst van Scan bij."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova gli scanner collegati e aggiorna l'elenco dei dispositivi di scansione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra scanners conectados e atualiza a lista de dispositivos do Scan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続されているスキャナを検索し、スキャンのデバイス リストを更新します。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı tarayıcıları bulur ve Scan'in cihaz listesini günceller."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث عن الماسحات الضوئية المتصلة وتحديث قائمة أجهزة المسح الضوئي."
          }
        }
      }
    },
