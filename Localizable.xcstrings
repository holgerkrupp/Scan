    "This scanner's driver does not support these options; they are used by Fujitsu SCSI-over-USB models such as the S1500 and iX500.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Treiber dieses Scanners unterstützt diese Optionen nicht. Sie werden von Fujitsu SCSI-over-USB-Modellen wie dem S1500 und dem iX500 verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pilote de ce scanner ne prend pas en charge ces options ; ils sont utilisés par les modèles Fujitsu SCSI-over-USB tels que le S1500 et l'iX500."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El controlador de este escáner no admite estas opciones; los utilizan los modelos SCSI sobre USB de Fujitsu, como el S1500 y el iX500."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스캐너의 드라이버는 이러한 옵션을 지원하지 않습니다. S1500 및 iX500과 같은 Fujitsu SCSI-over-USB 모델에서 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het stuurprogramma van deze scanner ondersteunt deze opties niet; ze worden gebruikt door Fujitsu SCSI-over-USB-modellen zoals de S1500 en iX500."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il driver di questo scanner non supporta queste opzioni; sono utilizzati dai modelli Fujitsu SCSI-over-USB come S1500 e iX500."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O driver deste scanner não oferece suporte a essas opções; eles são usados ​​​​por modelos Fujitsu SCSI sobre USB, como o S1500 e o iX500."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスキャナのドライバはこれらのオプションをサポートしていません。これらは、S1500 や iX500 などの Fujitsu SCSI-over-USB モデルで使用されます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarayıcının sürücüsü bu seçenekleri desteklemiyor; S1500 ve iX500 gibi Fujitsu SCSI-over-USB modelleri tarafından kullanılırlar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم برنامج تشغيل الماسحة الضوئية هذه الخيارات؛ يتم استخدامها بواسطة طرازات Fujitsu SCSI-over-USB مثل S1500 وiX500."
          }
        }
      }
    },
