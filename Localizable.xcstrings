    "Their files are saved, but their text and final name are still being added. Scan quits as soon as they are finished.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Dateien sind gespeichert, aber Text und endgültiger Name werden noch hinzugefügt. Scan wird beendet, sobald sie fertig sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leurs fichiers sont enregistrés, mais leur texte et leur nom définitif sont encore en cours d'ajout. Scan quittera dès qu'ils seront terminés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus archivos están guardados, pero aún se están añadiendo su texto y su nombre definitivo. Scan se cerrará en cuanto estén terminados."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 저장되었지만 텍스트와 최종 이름을 아직 추가하고 있습니다. 완료되는 즉시 Scan이 종료됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestanden zijn opgeslagen, maar de tekst en de definitieve naam worden nog toegevoegd. Scan stopt zodra ze klaar zijn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file sono salvati, ma il testo e il nome definitivo vengono ancora aggiunti. Scan si chiuderà non appena saranno completati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos estão salvos, mas o texto e o nome definitivo ainda estão sendo adicionados. O Scan será encerrado assim que forem concluídos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは保存済みですが、テキストと最終的な名前をまだ追加しています。完了しだいScanを終了します。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları kaydedildi, ancak metinleri ve son adları hâlâ ekleniyor. Tamamlanır tamamlanmaz Scan kapanacak."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ ملفاتها، لكن لا تزال تتم إضافة نصها واسمها النهائي. سيتم إنهاء Scan فور اكتمالها."
          }
        }
      }
    },
