    "No scans recorded yet. Scan records the history from now on; earlier scans are not counted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden noch keine Scans aufgezeichnet. Der Scan zeichnet den Verlauf von nun an auf; Frühere Scans werden nicht gezählt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun scan enregistré pour l'instant. Scan enregistre désormais l'historique ; les analyses antérieures ne sont pas comptées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se han registrado escaneos. Scan registra el historial a partir de ahora; Los escaneos anteriores no se cuentan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 기록된 스캔이 없습니다. 스캔은 지금부터 기록을 기록합니다. 이전 스캔은 계산되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn nog geen scans geregistreerd. Scan registreert voortaan de geschiedenis; eerdere scans worden niet meegeteld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scansione ancora registrata. La scansione registra la cronologia da ora in poi; le scansioni precedenti non vengono conteggiate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma varredura registrada ainda. A varredura registra o histórico a partir de agora; verificações anteriores não são contadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだスキャンは記録されていません。スキャンは今後履歴を記録します。以前のスキャンはカウントされません。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kayıtlı tarama yok. Tarama artık geçmişi kaydeder; daha önceki taramalar sayılmaz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تسجيل أي عمليات مسح حتى الآن. يقوم المسح بتسجيل التاريخ من الآن فصاعدا؛ لا يتم احتساب عمليات الفحص السابقة."
          }
        }
      }
    },
