    "Trims the paper margins down to the printed content, for receipts and clippings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneidet die Papierränder für Quittungen und Ausschnitte auf den gedruckten Inhalt zu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit les marges du papier jusqu'au contenu imprimé, pour les reçus et les coupures de presse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorta los márgenes del papel hasta el contenido impreso, para recibos y recortes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영수증 및 스크랩의 경우 인쇄된 내용에 맞춰 용지 여백을 자릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snijdt de papiermarges bij tot de afgedrukte inhoud, voor bonnen en knipsels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritaglia i margini della carta fino al contenuto stampato, per ricevute e ritagli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apara as margens do papel até o conteúdo impresso, para recibos e recortes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートや切り抜きなど、印刷内容に合わせて用紙の余白をトリミングします。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makbuz ve kupürler için kağıt kenar boşluklarını yazdırılan içeriğe göre keser."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم بقص هوامش الورق وصولاً إلى المحتوى المطبوع، للإيصالات والقصاصات."
          }
        }
      }
    },
