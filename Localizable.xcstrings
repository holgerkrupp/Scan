    "New scans are not counted. The figures above stay as they are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Scans werden nicht gezählt. Die obigen Zahlen bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux scans ne sont pas comptés. Les chiffres ci-dessus restent tels quels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nuevos escaneos no se cuentan. Las cifras anteriores permanecen como están."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 스캔은 계산되지 않습니다. 위의 수치는 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe scans worden niet meegeteld. De bovenstaande cijfers blijven zoals ze zijn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nuove scansioni non vengono conteggiate. Le cifre sopra rimangono così come sono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Novas varreduras não são contadas. Os números acima permanecem como estão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいスキャンはカウントされません。上の数値はそのままです。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni taramalar sayılmaz. Yukarıdaki rakamlar olduğu gibi kalıyor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم احتساب عمليات المسح الجديدة. الأرقام المذكورة أعلاه تبقى كما هي."
          }
        }
      }
    },
