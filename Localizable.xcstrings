    "Device capabilities are read when the Image Capture session opens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerätefunktionen werden gelesen, wenn die Image Capture-Sitzung geöffnet wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les capacités de l'appareil sont lues à l'ouverture de la session Image Capture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capacidades del dispositivo se leen cuando se abre la sesión de Captura de imagen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 캡처 세션이 열리면 장치 기능을 읽습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaatmogelijkheden worden gelezen wanneer de Image Capture-sessie wordt geopend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le funzionalità del dispositivo vengono lette all'apertura della sessione di acquisizione immagine."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recursos do dispositivo são lidos quando a sessão do Image Capture é aberta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの機能は、イメージ キャプチャ セッションが開くときに読み取られます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü Yakalama oturumu açıldığında cihaz özellikleri okunur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم قراءة إمكانيات الجهاز عند فتح جلسة التقاط الصور."
          }
        }
      }
    },
