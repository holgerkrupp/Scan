    "Paper jam. Remove the stuck sheet, then scan again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Papierstau. Entfernen Sie das festsitzende Blatt und scannen Sie dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bourrage papier. Retirez la feuille coincée, puis numérisez à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atasco de papel. Retire la hoja atascada y luego escanee nuevamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용지 걸림. 걸린 시트를 제거한 후 다시 스캔하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Papierstoring. Verwijder het vastzittende vel en scan opnieuw."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inceppamento della carta. Remove the stuck sheet, then scan again."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atolamento de papel. Remova a folha presa e digitalize novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙詰まり。詰まったシートを取り除き、再度スキャンしてください。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kağıt sıkışması. Sıkışan sayfayı çıkarın ve yeniden tarayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انحشار الورق. قم بإزالة الورقة العالقة، ثم قم بإجراء المسح الضوئي مرة أخرى."
          }
        }
      }
    },
    "Paper jams and multifeeds during a scan are always reported with their own message.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Papierstaus und Mehrfacheinzüge während eines Scans werden immer mit einer eigenen Meldung gemeldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bourrages papier et les alimentations multiples lors d'une numérisation sont toujours signalés avec leur propre message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atascos de papel y las alimentaciones múltiples durante un escaneo siempre se informan con su propio mensaje."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔 중 용지 걸림 및 복수 급지는 항상 자체 메시지와 함께 보고됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Papierstoringen en multi-invoer tijdens een scan worden altijd met een eigen melding gemeld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli inceppamenti della carta e le alimentazioni multiple durante una scansione vengono sempre segnalati con un messaggio specifico."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atolamentos de papel e alimentações múltiplas durante uma digitalização são sempre relatados com sua própria mensagem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン中の紙詰まりと重送は、常に独自のメッセージとともに報告されます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama sırasındaki kağıt sıkışmaları ve çoklu beslemeler her zaman kendi mesajlarıyla bildirilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم دائمًا الإبلاغ عن حالات انحشار الورق والتلقيمات المتعددة أثناء عملية المسح الضوئي من خلال رسالة خاصة بها."
          }
        }
      }
    },
