    "Over Wi-Fi the sensors cannot be checked before scanning.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über WLAN können die Sensoren vor dem Scannen nicht überprüft werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par Wi-Fi, les capteurs ne peuvent pas être vérifiés avant la numérisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A través de Wi-Fi, los sensores no se pueden verificar antes de escanear."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi를 사용하면 스캔하기 전에 센서를 확인할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Wi-Fi kunnen de sensoren niet worden gecontroleerd voordat ze worden gescand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tramite Wi-Fi i sensori non possono essere controllati prima della scansione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Através de Wi-Fi, os sensores não podem ser verificados antes da digitalização."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 経由では、スキャン前にセンサーをチェックできません。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi üzerinden sensörler taramadan önce kontrol edilemez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبر شبكة Wi-Fi، لا يمكن فحص المستشعرات قبل المسح."
          }
        }
      }
    },
