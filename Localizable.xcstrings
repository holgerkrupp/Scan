    "Every scan and export is counted for its scanner. The history stays on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Scan und Export wird für seinen Scanner gezählt. Der Verlauf bleibt auf diesem Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque numérisation et exportation est comptée pour son scanner. L'historique reste sur ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada escaneo y exportación se cuenta para su escáner. La historia permanece en esta Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 스캔 및 내보내기는 해당 스캐너에 대해 계산됩니다. 기록은 이 Mac에 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke scan en export wordt meegeteld voor de bijbehorende scanner. De geschiedenis blijft op deze Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni scansione ed esportazione viene conteggiata per il relativo scanner. La cronologia rimane su questo Mac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada digitalização e exportação é contada para seu scanner. A história permanece neste Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのスキャンとエクスポートは、そのスキャナーに対してカウントされます。履歴はこの Mac に残ります。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her tarama ve dışa aktarma, tarayıcısı için sayılır. Geçmiş bu Mac'te kalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم احتساب كل عملية مسح وتصدير للماسح الضوئي الخاص بها. يبقى التاريخ على جهاز Mac هذا."
          }
        }
      }
    },
    "Every scanned page was found blank. Turn off blank-page removal to see them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede gescannte Seite war leer. Deaktivieren Sie das Entfernen leerer Seiten, um sie anzuzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque page numérisée s'est révélée vierge. Désactivez la suppression des pages blanches pour les voir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada página escaneada se encontró en blanco. Desactiva la eliminación de páginas en blanco para verlas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔한 모든 페이지가 비어 있는 것으로 나타났습니다. 이를 보려면 빈 페이지 제거를 끄십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke gescande pagina bleek blanco te zijn. Schakel het verwijderen van lege pagina's uit om ze te zien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni pagina scansionata è stata trovata vuota. Disattiva la rimozione delle pagine vuote per visualizzarle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada página digitalizada foi encontrada em branco. Desative a remoção de páginas em branco para vê-las."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンしたすべてのページが空白でした。それらを表示するには、空白ページの削除をオフにしてください。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taranan her sayfa boş bulundu. Bunları görmek için boş sayfa kaldırmayı kapatın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على كل صفحة ممسوحة ضوئيًا فارغة. قم بإيقاف تشغيل إزالة الصفحات الفارغة لرؤيتها."
          }
        }
      }
    },
