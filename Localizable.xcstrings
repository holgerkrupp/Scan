    "The app listens only while a supported scanner session is open. Unsupported devices remain available for manual scans.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App lauscht nur, während eine unterstützte Scannersitzung geöffnet ist. Nicht unterstützte Geräte bleiben für manuelle Scans verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application écoute uniquement lorsqu'une session de scanner prise en charge est ouverte. Les appareils non pris en charge restent disponibles pour les analyses manuelles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación escucha solo mientras está abierta una sesión de escáner compatible. Los dispositivos no compatibles siguen estando disponibles para análisis manuales."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 지원되는 스캐너 세션이 열려 있는 동안에만 수신 대기합니다. 지원되지 않는 장치는 수동 검색에 계속 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app luistert alleen terwijl een ondersteunde scannersessie geopend is. Niet-ondersteunde apparaten blijven beschikbaar voor handmatige scans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app è in ascolto solo mentre è aperta una sessione di scansione supportata. I dispositivi non supportati rimangono disponibili per le scansioni manuali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo escuta apenas enquanto uma sessão de scanner compatível está aberta. Os dispositivos não suportados permanecem disponíveis para verificações manuais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは、サポートされているスキャナー セッションが開いている間のみリッスンします。サポートされていないデバイスは引き続き手動スキャンに使用できます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama yalnızca desteklenen bir tarayıcı oturumu açıkken dinler. Desteklenmeyen cihazlar manuel taramalar için kullanılabilir durumda kalır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمع التطبيق فقط أثناء فتح جلسة الماسح الضوئي المدعومة. تظل الأجهزة غير المدعومة متاحة لإجراء عمليات الفحص اليدوي."
          }
        }
      }
    },
    "The connection to the scanner was lost (%@).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum Scanner wurde unterbrochen (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion au scanner a été perdue (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión con el escáner (%@)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너 연결이 끊어졌습니다(%@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding met de scanner is verbroken (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione con lo scanner è stata interrotta (%@)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão com o scanner foi perdida (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナへの接続が失われました (%@)。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcıyla bağlantı kesildi (%@)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فقدان الاتصال بالماسح الضوئي (%@)."
          }
        }
      }
    },
    "The scanner has no registered computer, and Scan cannot register this Mac yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scanner hat keinen registrierten Computer und Scan kann diesen Mac noch nicht registrieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner n'a pas d'ordinateur enregistré et Scan ne peut pas encore enregistrer ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escáner no tiene una computadora registrada y Scan aún no puede registrar esta Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너에 등록된 컴퓨터가 없으며 Scan이 아직 이 Mac을 등록할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scanner heeft geen geregistreerde computer en Scan kan deze Mac nog niet registreren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scanner non ha un computer registrato e Scan non può ancora registrare questo Mac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O scanner não possui um computador registrado e o Scan ainda não pode registrar este Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナーには登録されたコンピューターがありません。Scan はまだこの Mac を登録できません。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcının kayıtlı bir bilgisayarı yok ve Tarama henüz bu Mac'i kaydedemiyor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد جهاز كمبيوتر مسجل لدى الماسح الضوئي، ولا يمكن لـ Scan تسجيل جهاز Mac هذا بعد."
          }
        }
      }
    },
    "The scanner is in use by other software (code -4). Quit ScanSnap Manager and ScanSnap Home, then turn the scanner off and on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scanner wird von anderer Software verwendet (Code -4). Beenden Sie ScanSnap Manager und ScanSnap Home und schalten Sie dann den Scanner aus und wieder ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner est utilisé par un autre logiciel (code -4). Quittez ScanSnap Manager et ScanSnap Home, puis éteignez et rallumez le scanner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escáner está siendo utilizado por otro software (código -4). Salga de ScanSnap Manager y ScanSnap Home, luego apague y encienda el escáner."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너가 다른 소프트웨어에서 사용 중입니다(코드 -4). ScanSnap Manager 및 ScanSnap Home을 종료한 다음 스캐너를 껐다가 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scanner wordt gebruikt door andere software (code -4). Sluit ScanSnap Manager en ScanSnap Home af en schakel de scanner vervolgens uit en weer in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scanner è utilizzato da un altro software (codice -4). Uscire da ScanSnap Manager e ScanSnap Home, quindi spegnere e riaccendere lo scanner."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O scanner está sendo usado por outro software (código -4). Saia do ScanSnap Manager e do ScanSnap Home e desligue e ligue o scanner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナは他のソフトウェアによって使用されています (コード -4)。 ScanSnap Manager および ScanSnap Home を終了し、スキャナーの電源をオフにしてからオンにします。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı başka bir yazılım tarafından kullanılıyor (kod -4). ScanSnap Manager ve ScanSnap Home'dan çıkın, ardından tarayıcıyı kapatıp açın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الماسح الضوئي قيد الاستخدام بواسطة برامج أخرى (الرمز -4). قم بإنهاء ScanSnap Manager وScanSnap Home، ثم قم بإيقاف تشغيل الماسح الضوئي وتشغيله."
          }
        }
      }
    },
    "The scanner is not responding over Wi-Fi. Make sure it is on (cover open) and on the same network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scanner reagiert nicht über WLAN. Stellen Sie sicher, dass es eingeschaltet ist (Abdeckung geöffnet) und sich im selben Netzwerk befindet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner ne répond pas via Wi-Fi. Assurez-vous qu'il est allumé (couvercle ouvert) et sur le même réseau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escáner no responde a través de Wi-Fi. Asegúrate de que esté encendido (tapa abierta) y en la misma red."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너가 Wi-Fi를 통해 응답하지 않습니다. 켜져 있고(커버가 열린 상태) 동일한 네트워크에 있는지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scanner reageert niet via Wi-Fi. Zorg ervoor dat deze is ingeschakeld (kap open) en op hetzelfde netwerk is aangesloten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scanner non risponde tramite Wi-Fi. Assicurati che sia acceso (coperchio aperto) e sulla stessa rete."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O scanner não está respondendo por Wi-Fi. Certifique-se de que esteja ligado (tampa aberta) e na mesma rede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナーが Wi-Fi 経由で応答しません。電源がオンになっていて (カバーが開いていて)、同じネットワーク上にあることを確認してください。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı Wi-Fi üzerinden yanıt vermiyor. Açık olduğundan (kapak açık) ve aynı ağda olduğundan emin olun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الماسح الضوئي لا يستجيب عبر شبكة Wi-Fi. تأكد من أنه قيد التشغيل (الغطاء مفتوح) وعلى نفس الشبكة."
          }
        }
      }
    },
    "The scanner refused its Wi-Fi password (code %d). Scan uses the factory password, the last 4 characters of the serial number.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scanner hat sein WLAN-Passwort abgelehnt (Code %d). Beim Scannen werden das Werkspasswort und die letzten 4 Zeichen der Seriennummer verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner a refusé son mot de passe Wi-Fi (code %d). Scan utilise le mot de passe d'usine, les 4 derniers caractères du numéro de série."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escáner rechazó su contraseña de Wi-Fi (código %d). Scan utiliza la contraseña de fábrica, los últimos 4 caracteres del número de serie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너가 Wi-Fi 비밀번호(코드 %d)를 거부했습니다. 스캔은 일련번호의 마지막 4자리인 공장 비밀번호를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scanner weigerde zijn Wi-Fi-wachtwoord (code %d). Scan gebruikt het fabriekswachtwoord, de laatste 4 tekens van het serienummer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scanner ha rifiutato la password Wi-Fi (codice %d). La scansione utilizza la password di fabbrica, ovvero gli ultimi 4 caratteri del numero di serie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O scanner recusou a senha do Wi-Fi (código %d). A digitalização utiliza a senha de fábrica, os últimos 4 caracteres do número de série."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナーが Wi-Fi パスワード (コード %d) を拒否しました。スキャンでは、工場出荷時のパスワード、つまりシリアル番号の最後の 4 文字が使用されます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı Wi-Fi şifresini reddetti (kod %d). Tarama, seri numarasının son 4 karakteri olan fabrika şifresini kullanır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الماسح الضوئي كلمة مرور Wi-Fi (الرمز %d). يستخدم المسح الضوئي كلمة مرور المصنع، وهي آخر 4 أحرف من الرقم التسلسلي."
          }
        }
      }
    },
    "The scanner refused the connection (code %d).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scanner hat die Verbindung abgelehnt (Code %d)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner a refusé la connexion (code %d)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escáner rechazó la conexión (código %d)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너가 연결을 거부했습니다(코드 %d)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scanner weigerde de verbinding (code %d)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scanner ha rifiutato la connessione (codice %d)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O scanner recusou a conexão (código %d)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナーが接続を拒否しました (コード %d)。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı bağlantıyı reddetti (kod %d)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الماسح الضوئي الاتصال (الرمز %d)."
          }
        }
      }
    },
    "The scanner refused this Mac (code -7): it is not in its list of registered computers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scanner hat diesen Mac abgelehnt (Code -7): Er ist nicht in seiner Liste der registrierten Computer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner a refusé ce Mac (code -7) : il n'est pas dans sa liste d'ordinateurs enregistrés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escáner rechazó este Mac (código -7): no está en su lista de ordenadores registrados."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너가 이 Mac(코드 -7)을 거부했습니다. 등록된 컴퓨터 목록에 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De scanner heeft deze Mac geweigerd (code -7): hij staat niet in de lijst met geregistreerde computers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scanner ha rifiutato questo Mac (codice -7): non è nell'elenco dei computer registrati."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O scanner recusou este Mac (código -7): ele não está na lista de computadores registrados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナーはこの Mac を拒否しました (コード -7)。登録されているコンピューターのリストにありません。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı bu Mac'i reddetti (kod -7): kayıtlı bilgisayarlar listesinde yok."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الماسح الضوئي جهاز Mac هذا (الرمز -7): فهو غير موجود في قائمة أجهزة الكمبيوتر المسجلة الخاصة به."
          }
        }
      }
    },
    "The scanner's cover is open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abdeckung des Scanners ist geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le capot du scanner est ouvert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tapa del escáner está abierta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캐너 덮개가 열려 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De klep van de scanner is open."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il coperchio dello scanner è aperto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tampa do scanner está aberta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャナーのカバーが開いています。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcının kapağı açık."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غطاء الماسحة الضوئية مفتوح."
          }
        }
      }
    },
    "This Mac has no network route to the scanner.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat keine Netzwerkroute zum Scanner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n'a pas de route réseau vers le scanner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Mac no tiene ruta de red hacia el escáner."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에는 스캐너에 대한 네트워크 경로가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac heeft geen netwerkroute naar de scanner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non ha un percorso di rete verso lo scanner."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não possui rota de rede para o scanner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac にはスキャナへのネットワーク ルートがありません。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'in tarayıcıya giden ağ yolu yok."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي جهاز Mac هذا على طريق شبكة إلى الماسح الضوئي."
          }
        }
      }
    },
    "This scanner": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Scanner"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce scanner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "este escáner"
          }
        },
        "ko": {
          "stringUnit": {
