            "value": "이 스캐너"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze scanner"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo scanner"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este scanner"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスキャナー"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarayıcı"
          }
        },
        "ar": {
